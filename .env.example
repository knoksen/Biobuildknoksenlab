# Jarle Local AI (OpenAI-compatible). Server-side only.
# PC, Ollama:            AI_BASE_URL=http://127.0.0.1:11434/v1
# PC, gateway:           AI_BASE_URL=http://127.0.0.1:8000/v1
# VPS (SSH tunnel):      AI_BASE_URL=http://127.0.0.1:11436/v1
AI_BASE_URL="http://127.0.0.1:11434/v1"
AI_MODEL="qwen3.5:4b"
# Vision model for image analysis (must accept images), e.g. gemma4:26b
# AI_VISION_MODEL="gemma4:26b"
# AI_API_KEY=""
# AI_TIMEOUT_MS="120000"

# APP_URL: public URL of this app (used for self-referential links).
APP_URL="MY_APP_URL"
